# Copy this file to .env and fill in real values before running the server.

# Port the API listens on
PORT=4000

# Long random string used to sign admin login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Used ONLY the very first time the server starts (to create the admin
# account). After that, the password lives in server/data/db.json and you
# manage it from the dashboard's Settings page instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Comma-separated list of origins allowed to call this API.
# For local dev, the Vite dev server default is http://localhost:5173
CORS_ORIGIN=http://localhost:5173
